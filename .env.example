# Copy to .env and fill in. Real values live in Bitwarden. Never commit .env.

APP_NAME=Minivora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DOMAIN=localhost            # production: your Minivora domain; stores live at <name>.<domain>
APP_SCHEME=http                 # production: https
APP_PORT_SUFFIX=8000            # port added to store links in local dev; empty in production
APP_TIMEZONE=Africa/Cairo

DB_CONNECTION=mysql             # quick local run without MySQL: sqlite (and remove the DB_* lines below)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=minivora
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=database       # stage 2: redis
CACHE_STORE=database            # stage 2: redis
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false     # production: true (NFR-SEC-03)
FILESYSTEM_DISK=local           # stage 3: s3

# Email (Hostinger SMTP; Brevo if limits are reached)
MAIL_MAILER=smtp                # local: log (emails go to storage/logs/laravel.log)
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@your-domain

# AI providers: comma-separated keys, rotated on rate limits
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=

# Payments (test mode)
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=

# Marketing
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Adorna pilot import
ADORNA_EXPORT_URL=
ADORNA_EXPORT_TOKEN=

# Backups (off-site)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
